[Unit]
Description=Red-DiscordBot container
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/ploos-as/red-discordbot:0.2.0
ContainerName=red-discordbot
EnvironmentFile=%h/.config/red-discordbot/red-discordbot.env
Volume=%h/.local/share/red-discordbot:/data:Z
Secret=red-discordbot-token,type=mount,target=/run/secrets/discord_token
Environment=TOKEN_FILE=/run/secrets/discord_token
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=16m
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
